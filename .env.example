# Copy this file to .env and fill values. Do not commit secrets.

# Remote server access
WP_SSH_HOST=example.com
WP_SSH_PORT=22
WP_SSH_USER=ubuntu
WP_ROOT=/var/www/html

# Restic repository (choose one).
# Local path example:
# RESTIC_REPOSITORY=/Volumes/Backups/wordpress-restic
# Backblaze B2 example (requires env vars B2_ACCOUNT_ID/B2_ACCOUNT_KEY):
# RESTIC_REPOSITORY=b2:my-bucket:wp-restic
# SFTP example:
# RESTIC_REPOSITORY=sftp:ubuntu@example.com:/srv/restic/wp
RESTIC_REPOSITORY=/path/to/restic-repo

# S3-compatible examples (requires AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY):
# AWS S3:
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/my-bucket
# Wasabi:
# RESTIC_REPOSITORY=s3:https://s3.eu-central-1.wasabisys.com/my-bucket
# Cloudflare R2:
# RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/my-bucket

# SMB (Samba) share (mount first, then use a local path)
# RESTIC_REPOSITORY=/Volumes/BackupShare/wp-restic

# rclone options
# Serve restic via rclone (http):
# RESTIC_REPOSITORY=rest:http://localhost:8080
# Or mount a remote and use a local path:
# RESTIC_REPOSITORY=/Volumes/ResticRepo

# When running in Docker, mount your .env and restic password file into /app (see README Docker section)

# Store the restic password in a secure file and point to it here.
RESTIC_PASSWORD_FILE=$HOME/.config/restic/wp_repo_password

# Optional: rsync excludes, comma-separated
RSYNC_EXCLUDES=wp-content/cache/,wp-content/uploads/backups/,node_modules/

# Optional: retention policy (space-separated flags, passed individually to restic forget --prune)
RETENTION_FLAGS="--keep-daily 14 --keep-weekly 8 --keep-monthly 12"

# Optional: where to keep local artifacts (dedicated directory)
# Recommended:
# BACKUP_DIR=./var/backups/wp
BACKUP_DIR=./backup_artifacts

# Optional: backup concurrency lock directory
# LOCK_DIR=./backup_artifacts/.backup.lock

# Optional: verify restic repository after each backup
RESTIC_CHECK_AFTER_BACKUP=no
# Optional subset for faster checks, e.g. 1/50 (instead of full read-data check)
# RESTIC_CHECK_READ_DATA_SUBSET=1/50

# Optional: include server configs (comma-separated absolute paths on server)
# Example: copy web server configs and certificates
# SERVER_CONFIG_PATHS=/etc/nginx,/etc/apache2,/etc/letsencrypt

# Optional: DNS export script (runs locally)
# Provide a script that writes DNS records into the output directory
# Example for Cloudflare:
# DNS_BACKUP_SCRIPT=./scripts/dns_export_cloudflare.sh

# Cloudflare credentials (if using the helper script)
# CLOUDFLARE_API_TOKEN=your_token_here
# CLOUDFLARE_ZONE_ID=your_zone_id_here

# Automated upgrade workflow (scripts/upgrade_with_rollback.sh)
# Healthcheck URL. If unset, script attempts auto-detection via: wp option get home
# HEALTHCHECK_URL=https://example.com
HEALTHCHECK_EXPECT_CODE=200
HEALTHCHECK_RETRIES=5
HEALTHCHECK_DELAY_SECONDS=15
HEALTHCHECK_TIMEOUT_SECONDS=20

# Validate backup artifacts locally before any production upgrade step
VALIDATE_BACKUP_BEFORE_UPGRADE=yes

# Optional double-secure gate: run full rehearsal on staging before prod upgrade
RUN_STAGING_REHEARSAL_BEFORE_UPGRADE=no

# Staging target used by scripts/staging_rehearsal.sh
# STAGING_WP_SSH_HOST=staging.example.com
# STAGING_WP_SSH_PORT=22
# STAGING_WP_SSH_USER=ubuntu
# STAGING_WP_ROOT=/var/www/html
# STAGING_HEALTHCHECK_URL=https://staging.example.com

# Optional staging settings
# STAGING_WP_CLI_BIN=wp
# STAGING_WP_CLI_EXTRA_ARGS=--allow-root
STAGING_HEALTHCHECK_EXPECT_CODE=200
STAGING_HEALTHCHECK_RETRIES=5
STAGING_HEALTHCHECK_DELAY_SECONDS=15
STAGING_HEALTHCHECK_TIMEOUT_SECONDS=20
# STAGING_EXTRA_POST_UPGRADE_CHECK_CMD=wp core is-installed
STAGING_APPLY_CONFIGS=no
STAGING_DELETE_REMOTE_FILES=no
STAGING_REMOTE_SUDO=no
# STAGING_REHEARSAL_REPORT_DIR=./var/reports/wp_staging_rehearsal

# Ask for interactive approval before upgrade (set FORCE_UPGRADE=yes for unattended runs)
ASK_CONFIRM_BEFORE_UPGRADE=yes
FORCE_UPGRADE=no

# Rollback behavior on failure
AUTO_RESTORE_ON_FAILURE=yes
APPLY_CONFIGS_ON_ROLLBACK=no
DELETE_REMOTE_FILES_ON_ROLLBACK=no
REMOTE_SUDO_ON_ROLLBACK=no

# Report output directory
UPGRADE_REPORT_DIR=./var/reports/wp_upgrade

# Optional WP-CLI settings (remote)
# WP_CLI_BIN=wp
# WP_CLI_EXTRA_ARGS=--allow-root

# Optional extra post-upgrade check command executed on remote inside WP_ROOT
# EXTRA_POST_UPGRADE_CHECK_CMD=wp core is-installed
